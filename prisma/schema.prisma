generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String   @id @default(uuid())
  name                            String
  email                           String   @unique
  phone                           String?
  password_hash                   String
  role                            Role @default(USER)
  status                          UserStatus @default(ACTIVE)
  profile_image                   String?
  last_login_at                   DateTime?
  email_verified                  Boolean  @default(false)
  refresh_token                   String?
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt
  deleted_at                      DateTime?
  company                         Company? @relation(fields: [company_id], references: [id])
  company_id                      String?
  warehouse_manager               Warehouse[] @relation("warehouse_manager")
  warehouse_logistic_manager      Warehouse[] @relation("logistic_manager")
  stock_movements                 StockMovement[]
  requested_transfers             Transfer[] @relation("requested_transfers")
  approved_transfers              Transfer[] @relation("approved_transfers")
  user_orders                     Order[] @relation("user_orders")
}

model Company {
  id                      String            @id @default(uuid())
  name                    String
  email                   String            @unique
  contact_no              String?
  password_hash           String
  status                  CompanyStatus     @default(PENDING)
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  users                   User[]
  warehouses              Warehouse[]
  warehouse_created_by    Warehouse[]       @relation("created_by")
  warehouse_updated_by    Warehouse[]       @relation("updated_by")
}

model Warehouse{
  id                          String            @id @default(uuid())
  warehouse_company_id        String            @db.VarChar(40)
  company_id                  Company           @relation(fields: [warehouse_company_id], references:[id])
  warehouse_code              String            @db.VarChar(40) @unique
  name                        String            @db.VarChar(40)
  contact_phone               String? 
  operating_hours             String?
  is_active                   Boolean           @default(true)
  status                      WarehouseStatus   @default(OPERATIONAL)
  warehouse_manager_id        String?           @db.VarChar(40)
  warehouse_manager           User?             @relation("warehouse_manager", fields:[warehouse_manager_id], references:[id])
  logistic_manager_id         String?           @db.VarChar(40)
  logistic_manager            User?             @relation("logistic_manager", fields:[logistic_manager_id], references:[id])
  created_by_id               String?           @db.VarChar(40)
  created_by                  Company?          @relation("created_by", fields:[created_by_id], references:[id])
  updated_by_id               String?           @db.VarChar(40)
  updated_by                  Company?          @relation("updated_by", fields:[updated_by_id], references:[id])
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt
  deleted_at                  DateTime?
  warehouse_location          WarehouseLocation[] @relation("warehouse")
  warehouse_capacity          WarehouseCapacity[] @relation("warehouse")
  warehouse_inventory         Inventory[] @relation("warehouse_inventory")
  source_transfers            Transfer[] @relation("source_transfers")
  destination_transfers       Transfer[] @relation("destination_transfers")
}

model WarehouseLocation{
  id                    String    @id @default(uuid())
  warehouse_id          String    @db.VarChar(40)
  warehouse             Warehouse @relation("warehouse", fields:[warehouse_id], references:[id])
  address_line1         String    
  address_line2         String?     
  city                  String    @db.VarChar(40)
  state                 String    @db.VarChar(40)
  pincode               String    @db.VarChar(12)
  country               String    @db.VarChar(40)
  latitude              Decimal?  @db.Decimal(9,6)
  longitude             Decimal?  @db.Decimal(9,6)
}

model WarehouseCapacity{
  id                  String        @id @default(uuid())
  warehouse_id        String        @db.VarChar(40)
  warehouse           Warehouse     @relation("warehouse", fields:[warehouse_id], references:[id])
  total_capacity      Decimal       @db.Decimal(12,2)
  capacity_unit       CapacityUnit  @default(SQF)
  warehouse_type      WarehouseType @default(AMBIENT)
}

model Product {
  id          String      @id @default(uuid())
  name        String
  sku         String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  inventory   Inventory[]
  order_items OrderItem[]
  transfers   Transfer[]
}

model Inventory {
  id                  String          @id @default(uuid())
  warehouse_id        String          @db.VarChar(40)
  warehouse           Warehouse       @relation("warehouse_inventory", fields: [warehouse_id], references: [id])
  product_id          String
  product             Product         @relation(fields: [product_id], references: [id])
  quantity            Int             @default(0)
  low_stock_threshold Int             @default(10)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  movements           StockMovement[]

  @@unique([warehouse_id, product_id])
}

model StockMovement {
  id            String            @id @default(uuid())
  inventory_id  String
  inventory     Inventory         @relation(fields: [inventory_id], references: [id])
  type          StockMovementType
  quantity      Int
  reference_id  String?
  reason        String?
  created_by_id String?           @db.VarChar(40)
  created_by    User?             @relation(fields: [created_by_id], references: [id])
  created_at    DateTime          @default(now())
}

model Transfer {
  id                       String         @id @default(uuid())
  source_warehouse_id      String         @db.VarChar(40)
  source_warehouse         Warehouse      @relation("source_transfers", fields: [source_warehouse_id], references: [id])
  destination_warehouse_id String         @db.VarChar(40)
  destination_warehouse    Warehouse      @relation("destination_transfers", fields: [destination_warehouse_id], references: [id])
  product_id               String
  product                  Product        @relation(fields: [product_id], references: [id])
  quantity                 Int
  status                   TransferStatus @default(PENDING)
  requested_by_id          String?        @db.VarChar(40)
  requested_by             User?          @relation("requested_transfers", fields: [requested_by_id], references: [id])
  approved_by_id           String?        @db.VarChar(40)
  approved_by              User?          @relation("approved_transfers", fields: [approved_by_id], references: [id])
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
}

model Order {
  id           String      @id @default(uuid())
  user_id      String      @db.VarChar(40)
  user         User        @relation("user_orders", fields: [user_id], references: [id])
  status       OrderStatus @default(PENDING)
  total_amount Decimal     @db.Decimal(10, 2)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  order_items  OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id])
  product_id String
  product    Product  @relation(fields: [product_id], references: [id])
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WORKSPACE_MANAGER
  LOGISTIC_MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CapacityUnit{
  SQF
  CBM
  PALLETS
}

enum WarehouseType{
  AMBIENT
  COLD
  HAZMAT
}

enum WarehouseStatus{
  OPERATIONAL
  MAINTENANCE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum TransferStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
